# Variáveis de ambiente da aplicação (sem os valores).
# No PC: copie para .env.local e preencha. Na Vercel: Settings > Environment Variables.

# Segredo usado para assinar o cookie de sessão (texto longo e aleatório, 16+ caracteres)
SESSAO_SEGREDO=

# Usuário administrador que entra no sistema
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_SENHA=
